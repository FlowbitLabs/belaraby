<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store</string>
  <key>teamID</key>
  <string>DH3FB9KB74</string>
  <!-- Manual signing: CI runners only have the distribution certificate and
       the manually downloaded App Store profile installed; automatic signing
       would demand a development cert / Xcode-managed profile and fail with
       "No profiles for com.belaraby.belaraby were found". The profile in the
       Apple Developer portal MUST be named exactly "BelAraby App Store"
       (matches PROVISIONING_PROFILE_SPECIFIER in the Runner Release config). -->
  <key>signingStyle</key>
  <string>manual</string>
  <key>signingCertificate</key>
  <string>Apple Distribution</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.belaraby.belaraby</key>
    <string>BelAraby App Store</string>
  </dict>
  <key>uploadBitcode</key>
  <false/>
  <key>compileBitcode</key>
  <false/>
  <key>uploadSymbols</key>
  <true/>
</dict>
</plist>
